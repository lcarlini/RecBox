<Window x:Class="RecBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RecBox"
        Height="640" Width="520"
        MinHeight="560" MinWidth="460"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="RecBox" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Simple Windows screen recorder — no streaming, no clutter."
                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Status card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TimerText" Text="00:00:00" FontSize="28" FontWeight="Bold"
                               Margin="0,6,0,0" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock x:Name="EncoderText" Text="" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
                    <TextBlock x:Name="LastFileText" Text="" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="RecordButton" Content="Start recording"
                            Style="{StaticResource PrimaryButton}"
                            Click="RecordButton_Click" MinWidth="140"/>
                    <Button x:Name="OpenFolderButton" Content="Open folder"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,8,0,0" Click="OpenFolderButton_Click" MinWidth="140"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Settings -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                    <Label Content="Monitor"/>
                    <ComboBox x:Name="MonitorCombo" DisplayMemberPath="DisplayName"
                              SelectionChanged="SettingsChanged"/>

                    <Label Content="Microphone"/>
                    <ComboBox x:Name="MicrophoneCombo" DisplayMemberPath="DisplayName"
                              SelectionChanged="SettingsChanged"/>

                    <CheckBox x:Name="MicCheck" Content="Record microphone"
                              Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                    <CheckBox x:Name="SystemAudioCheck" Content="Record system audio"
                              Checked="SettingsChanged" Unchecked="SettingsChanged"/>

                    <Label Content="Recording quality"/>
                    <ComboBox x:Name="QualityCombo" SelectionChanged="SettingsChanged"/>

                    <Label Content="Output folder"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputFolderBox" LostFocus="OutputFolderBox_LostFocus"/>
                        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,12"
                                Style="{StaticResource SecondaryButton}"
                                Click="BrowseFolder_Click" Padding="12,6"/>
                    </Grid>

                    <TextBlock x:Name="HintText"
                               Text="Tip: Minimize this window to hide it from the taskbar and keep recording from the system tray."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer error -->
        <TextBlock Grid.Row="3" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
    </Grid>
</Window>
