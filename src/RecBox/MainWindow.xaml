<Window x:Class="RecBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RecBox"
        Height="720" Width="560"
        MinHeight="640" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Border CornerRadius="22" BorderBrush="#FF2A3342" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF0B0E12" Offset="0"/>
                <GradientStop Color="#FF121820" Offset="0.5"/>
                <GradientStop Color="#FF0D1518" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <!-- Ambient glow -->
            <Ellipse Width="320" Height="320" Margin="-80,-120,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Fill="#332DD4BF" Opacity="0.55">
                <Ellipse.Effect>
                    <BlurEffect Radius="80"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="280" Height="280" Margin="0,-40,-100,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="#22FF4D5E" Opacity="0.45">
                <Ellipse.Effect>
                    <BlurEffect Radius="90"/>
                </Ellipse.Effect>
            </Ellipse>

            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Grid Grid.Row="0" Height="52" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Border Width="26" Height="26" CornerRadius="8" Background="#FF171C25"
                                BorderBrush="#FF2A3342" BorderThickness="1">
                            <Grid>
                                <Ellipse Width="16" Height="16" Stroke="#FF2DD4BF" StrokeThickness="2"/>
                                <Ellipse Width="7" Height="7" Fill="#FFFF4D5E"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="RecBox" Margin="10,0,0,0" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Border Background="#222DD4BF" CornerRadius="8" Padding="8,3" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="Windows" FontSize="11" Foreground="#FF2DD4BF" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                        <Button Style="{StaticResource ChromeButton}" Content="─" Click="Minimize_Click" ToolTip="Minimize to tray"/>
                        <Button Style="{StaticResource CloseChromeButton}" Content="✕" Click="Close_Click" ToolTip="Hide to tray"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,8">
                    <StackPanel>
                        <!-- Hero / status -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,4,0,16" Padding="22">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#E6171C25" Offset="0"/>
                                    <GradientStop Color="#CC141A20" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource SuccessBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="StatusText" Text="Ready to record" FontSize="20" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TimerText" Text="00:00:00" FontSize="42" FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontFamily="Segoe UI Variable Display, Cascadia Mono, Consolas"/>
                                    <TextBlock Text="Simple screen capture — no streaming, no clutter."
                                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12"/>
                    <TextBlock x:Name="MonitorSummaryText" Text="" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="EncoderText" Text="" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                    <TextBlock x:Name="LastFileText" Text="" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="WarningText" Text="" TextWrapping="Wrap" Margin="0,8,0,0"
                               Foreground="#FFFFC857" Visibility="Collapsed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                                    <!-- Big record control -->
                                    <Grid Width="108" Height="108" HorizontalAlignment="Center" Margin="0,0,0,14">
                                        <Ellipse x:Name="PulseRing" Width="108" Height="108"
                                                 Stroke="#66FF4D5E" StrokeThickness="2" Opacity="0"/>
                                        <Button x:Name="RecordButton" Width="88" Height="88"
                                                Click="RecordButton_Click" Cursor="Hand"
                                                ToolTip="Start or stop recording">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Ellipse x:Name="Outer" Fill="{StaticResource TealButtonGradient}">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45" Color="#2DD4BF"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                        <Ellipse Width="28" Height="28" Fill="#FF0B0E12" Opacity="0.15"/>
                                                        <Ellipse x:Name="InnerDot" Width="26" Height="26" Fill="#FF0B0E12"/>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Outer" Property="Opacity" Value="0.92"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="RecordLabel" Text="Start" HorizontalAlignment="Center"
                                               FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Button x:Name="OpenFolderButton" Content="Open folder"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="OpenFolderButton_Click" MinWidth="140"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Settings -->
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,16">
                                    <TextBlock Text="Settings" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock DockPanel.Dock="Right" Text="Saved automatically"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12"
                                               VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="MONITOR"/>
                                <ComboBox x:Name="MonitorCombo" DisplayMemberPath="DisplayName"
                                          SelectionChanged="SettingsChanged"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="MICROPHONE"/>
                                <ComboBox x:Name="MicrophoneCombo" DisplayMemberPath="DisplayName"
                                          SelectionChanged="SettingsChanged"/>

                                <CheckBox x:Name="MicCheck" Content="Record microphone"
                                          Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                                <CheckBox x:Name="SystemAudioCheck" Content="Record system audio"
                                          Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                                <TextBlock x:Name="SystemAudioHint" TextWrapping="Wrap" Margin="0,-4,0,12"
                                           Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"
                                           Text="No active playback device detected. Plug in speakers/headphones or enable a playback device in Windows Sound settings."/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="QUALITY"/>
                                <ComboBox x:Name="QualityCombo" SelectionChanged="SettingsChanged"/>

                                <TextBlock Style="{StaticResource FieldLabel}" Text="OUTPUT FOLDER"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="OutputFolderBox" LostFocus="OutputFolderBox_LostFocus"/>
                                    <Button Grid.Column="1" Content="Browse"
                                            Margin="8,0,0,14"
                                            Style="{StaticResource SecondaryButton}"
                                            Click="BrowseFolder_Click" Padding="14,10"/>
                                </Grid>

                                <Border Background="#142DD4BF" CornerRadius="12" Padding="12,10" Margin="0,4,0,0">
                                    <TextBlock x:Name="HintText" TextWrapping="Wrap"
                                               Foreground="#FFB7F5EC"
                                               Text="Tip: minimize or close this window to hide RecBox from the taskbar while recording continues from the tray."/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap" Margin="22,0,22,16" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
