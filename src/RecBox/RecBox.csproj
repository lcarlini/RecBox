<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\recbox.ico</ApplicationIcon>
    <RootNamespace>RecBox</RootNamespace>
    <AssemblyName>RecBox</AssemblyName>
    <Version>1.0.0</Version>
    <Product>RecBox</Product>
    <Description>Lightweight Windows screen recorder</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\recbox.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
